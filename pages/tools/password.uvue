<template>
	<scroll-view class="page" scroll-y="true">
		<view class="card">
			<input class="input" :value="ruleName" @input="onName" placeholder="规则名，比如 后台口令" />
			<view class="gap"></view>
			<input class="input" type="number" :value="len" @input="onLen" placeholder="长度" />
			<view class="gap"></view>
			<text class="line" @click="up = !up">大写 {{ up ? '开' : '关' }}</text>
			<text class="line" @click="low = !low">小写 {{ low ? '开' : '关' }}</text>
			<text class="line" @click="num = !num">数字 {{ num ? '开' : '关' }}</text>
			<text class="line" @click="sym = !sym">符号 {{ sym ? '开' : '关' }}</text>
			<view class="gap"></view>
			<text class="btn" @click="gen">按当前规则生成</text>
			<view class="gap"></view>
			<text class="sec" @click="copyText(result)">{{ result }}</text>
			<view class="gap"></view>
			<text class="btn-ghost" @click="save">保存这套规则</text>
		</view>
		<view class="card">
			<text class="sec">常用规则</text>
			<view class="item" v-for="it in list" :key="it.id" @click="load(it)">
				<text>{{ it.name }}</text>
				<text class="del" @click.stop="del(it.id)">删</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="ts">
	import { loadNamedList, saveNamedItem, removeNamedItem } from '../../common/named'
	import { objStr, copyText } from '../../common/store'
	import { pushHistory } from '../../common/user'

	type Row = { id: string, name: string, payload: string }

	const KEY = 'pwd_tpl'
	const ruleName = ref('常用 12 位')
	const len = ref('12')
	const up = ref(true)
	const low = ref(true)
	const num = ref(true)
	const sym = ref(false)
	const result = ref('')
	const list = ref([] as Row[])

	function onName(e: UniInputEvent) { ruleName.value = e.detail.value }
	function onLen(e: UniInputEvent) { len.value = e.detail.value }

	function pool(): string {
		let s = ''
		if (up.value) s += 'ABCDEFGHJKLMNPQRSTUVWXYZ'
		if (low.value) s += 'abcdefghijkmnpqrstuvwxyz'
		if (num.value) s += '23456789'
		if (sym.value) s += '!@#$%*?'
		return s
	}

	function gen() {
		const chars = pool()
		if (chars.length == 0) {
			uni.showToast({ title: '至少开一类字符', icon: 'none' })
			return
		}
		let n = parseInt(len.value)
		if (isNaN(n) || n < 4) n = 8
		if (n > 64) n = 64
		let out = ''
		for (let i = 0; i < n; i++) {
			const idx = Math.floor(Math.random() * chars.length)
			out += chars.charAt(idx)
		}
		result.value = out
	}

	function save() {
		const payload = '{"len":"' + len.value + '","up":"' + (up.value ? '1' : '0') + '","low":"' + (low.value ? '1' : '0') + '","num":"' + (num.value ? '1' : '0') + '","sym":"' + (sym.value ? '1' : '0') + '"}'
		saveNamedItem(KEY, ruleName.value, payload, 10)
		pushHistory('password', ruleName.value, payload)
		reload()
	}

	function load(it: Row) {
		ruleName.value = it.name
		try {
			const o = JSON.parse(it.payload) as UTSJSONObject
			len.value = objStr(o, 'len', '12')
			up.value = objStr(o, 'up', '1') == '1'
			low.value = objStr(o, 'low', '1') == '1'
			num.value = objStr(o, 'num', '1') == '1'
			sym.value = objStr(o, 'sym', '0') == '1'
			gen()
		} catch (e) {}
	}

	function del(id: string) {
		removeNamedItem(KEY, id)
		reload()
	}

	function reload() {
		const arr = loadNamedList(KEY)
		const out: Row[] = []
		for (let i = 0; i < arr.length; i++) {
			out.push({
				id: objStr(arr[i], 'id', '' + i),
				name: objStr(arr[i], 'name', '规则'),
				payload: objStr(arr[i], 'payload', '')
			} as Row)
		}
		list.value = out
	}

	onLoad(() => { reload() })
</script>

<style>
	.sec { font-size: 30rpx; font-weight: 700; word-break: break-all; }
	.line { padding: 16rpx 0; border-bottom: 1px solid #E7DFD3; font-size: 28rpx; }
	.item { flex-direction: row; justify-content: space-between; padding: 16rpx 0; border-top: 1px solid #E7DFD3; }
	.del { color: #C2410C; }
</style>
