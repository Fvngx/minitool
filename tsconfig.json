{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "env.d.ts",
    "main.ts",
    "common/**/*.ts",
    "pages/**/*.uvue",
    "App.uvue"
  ],
  "exclude": ["node_modules", "dist", "unpackage"]
}
