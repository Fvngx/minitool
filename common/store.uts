/**
 * 本地存储统一入口。
 * 全部用字符串落盘，避免各端对对象序列化不一致。
 * 数据只存在用户设备，不上传。
 */

const PREFIX = 'mt_'

export function storageKey(name : string) : string {
	return PREFIX + name
}

export function readText(name : string, fallback : string) : string {
	const key = storageKey(name)
	const raw = uni.getStorageSync(key)
	if (raw == null) {
		return fallback
	}
	return '' + raw
}

export function writeText(name : string, value : string) {
	uni.setStorageSync(storageKey(name), value)
}

export function readList(name : string) : UTSJSONObject[] {
	const text = readText(name, '[]')
	try {
		const parsed = JSON.parse(text)
		if (parsed instanceof Array) {
			const list : UTSJSONObject[] = []
			const arr = parsed as Array<any>
			for (let i = 0; i < arr.length; i++) {
				const item = arr[i]
				if (item instanceof UTSJSONObject) {
					list.push(item as UTSJSONObject)
				} else if (typeof item == 'object' && item != null) {
					list.push(item as UTSJSONObject)
				}
			}
			return list
		}
	} catch (e) {
		console.log('读取列表失败', name, e)
	}
	return [] as UTSJSONObject[]
}

export function writeList(name : string, list : UTSJSONObject[]) {
	writeText(name, JSON.stringify(list))
}

export function nowId() : string {
	return Date.now().toString()
}

export function nowText() : string {
	const d = new Date()
	const y = d.getFullYear()
	const m = pad2(d.getMonth() + 1)
	const day = pad2(d.getDate())
	const h = pad2(d.getHours())
	const min = pad2(d.getMinutes())
	return y + '-' + m + '-' + day + ' ' + h + ':' + min
}

function pad2(n : number) : string {
	if (n < 10) {
		return '0' + n
	}
	return '' + n
}

export function copyText(text : string) {
	uni.setClipboardData({
		data: text,
		success: () => {
			uni.showToast({ title: '已复制', icon: 'none' })
		}
	})
}

export function objStr(obj : UTSJSONObject, key : string, fallback : string) : string {
	const v = obj[key]
	if (v == null) {
		return fallback
	}
	return '' + v
}

export function objNum(obj : UTSJSONObject, key : string, fallback : number) : number {
	const v = obj[key]
	if (v == null) {
		return fallback
	}
	const n = parseFloat('' + v)
	if (isNaN(n)) {
		return fallback
	}
	return n
}

export function objBool(obj : UTSJSONObject, key : string, fallback : boolean) : boolean {
	const v = obj[key]
	if (v == null) {
		return fallback
	}
	if (typeof v == 'boolean') {
		return v as boolean
	}
	const s = ('' + v).toLowerCase()
	return s == 'true' || s == '1'
}

export function makeObj(pairs : string[]) : UTSJSONObject {
	const o = {} as UTSJSONObject
	let i = 0
	while (i + 1 < pairs.length) {
		o[pairs[i]] = pairs[i + 1]
		i = i + 2
	}
	return o
}
