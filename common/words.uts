/**
 * 关键词清洗：换行/逗号切开，去空、去重，可选排序。
 */
export function splitWords(raw : string) : string[] {
	const tmp = replaceChar(replaceChar(replaceChar(raw, '，', '\n'), ',', '\n'), '、', '\n')
	const parts = tmp.split('\n')
	const out : string[] = []
	for (let i = 0; i < parts.length; i++) {
		const w = parts[i].trim()
		if (w.length == 0) {
			continue
		}
		if (!hasWord(out, w)) {
			out.push(w)
		}
	}
	return out
}

export function sortWords(list : string[]) : string[] {
	const copy : string[] = []
	for (let i = 0; i < list.length; i++) {
		copy.push(list[i])
	}
	for (let i = 0; i < copy.length; i++) {
		for (let j = i + 1; j < copy.length; j++) {
			if (copy[j] < copy[i]) {
				const t = copy[i]
				copy[i] = copy[j]
				copy[j] = t
			}
		}
	}
	return copy
}

export function joinWords(list : string[]) : string {
	let s = ''
	for (let i = 0; i < list.length; i++) {
		if (i > 0) {
			s += '\n'
		}
		s += list[i]
	}
	return s
}

function hasWord(list : string[], w : string) : boolean {
	for (let i = 0; i < list.length; i++) {
		if (list[i] == w) {
			return true
		}
	}
	return false
}

function replaceChar(src : string, a : string, b : string) : string {
	let out = ''
	for (let i = 0; i < src.length; i++) {
		const ch = src.charAt(i)
		if (ch == a) {
			out += b
		} else {
			out += ch
		}
	}
	return out
}
