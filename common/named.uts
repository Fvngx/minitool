/**
 * 各工具自己的「模板 / 历史」列表。
 * 约定字段：id、name、payload、at
 */
import { readList, writeList, nowId, nowText, objStr, makeObj } from './store.uts'

export function loadNamedList(key : string) : UTSJSONObject[] {
	return readList(key)
}

export function saveNamedItem(key : string, name : string, payload : string, limit : number) : UTSJSONObject {
	const list = readList(key)
	const item = makeObj([
		'id', nowId(),
		'name', name,
		'payload', payload,
		'at', nowText()
	])
	const next : UTSJSONObject[] = [item]
	for (let i = 0; i < list.length; i++) {
		if (next.length >= limit) {
			break
		}
		next.push(list[i])
	}
	writeList(key, next)
	return item
}

export function upsertNamedItem(key : string, id : string, name : string, payload : string, limit : number) : UTSJSONObject {
	const list = readList(key)
	if (id.length == 0) {
		return saveNamedItem(key, name, payload, limit)
	}
	const next : UTSJSONObject[] = []
	let updated : UTSJSONObject | null = null
	for (let i = 0; i < list.length; i++) {
		if (objStr(list[i], 'id', '') == id) {
			const item = makeObj([
				'id', id,
				'name', name,
				'payload', payload,
				'at', nowText()
			])
			updated = item
			next.push(item)
		} else {
			next.push(list[i])
		}
	}
	if (updated == null) {
		return saveNamedItem(key, name, payload, limit)
	}
	writeList(key, next)
	return updated!
}

export function removeNamedItem(key : string, id : string) {
	const list = readList(key)
	const next : UTSJSONObject[] = []
	for (let i = 0; i < list.length; i++) {
		if (objStr(list[i], 'id', '') != id) {
			next.push(list[i])
		}
	}
	writeList(key, next)
}

export function prependUnique(key : string, title : string, payload : string, limit : number) {
	const list = readList(key)
	const next : UTSJSONObject[] = [makeObj([
		'id', nowId(),
		'name', title,
		'payload', payload,
		'at', nowText()
	])]
	for (let i = 0; i < list.length; i++) {
		if (next.length >= limit) {
			break
		}
		if (objStr(list[i], 'payload', '') != payload) {
			next.push(list[i])
		}
	}
	writeList(key, next)
}
